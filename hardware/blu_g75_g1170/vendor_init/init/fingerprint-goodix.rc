service vendor.side.fingerprint /vendor/bin/hw/vendor.hardware.biometrics.side.aidl.fingerprint-service
    # "class hal" causes a race condition on some devices due to files created
    # in /data. As a workaround, postpone startup until later in boot once
    # /data is mounted.
    class late_start
    user system
    group system input uhid
    writepid /dev/cpuset/top-app/tasks	
on post-fs-data
    chmod 0666 /dev/goodix_fp
    chown system system /dev/goodix_fp

on post-fs-data && property:ro.debuggable=1
    mkdir /data/vendor/fpdump 0777 system system

